# ========================================================
# Resolve AI - Environment Configuration Template
# ========================================================

# Nexconn Chat SDK (Sign up at https://nexconn.ai)
NEXCONN_APP_KEY=your_nexconn_app_key_here
NEXCONN_APP_SECRET=your_nexconn_app_secret_here

# Gemini AI API (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase (Optional - persistent cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend Server Port & Client URL
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
